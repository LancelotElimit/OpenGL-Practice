# A small textured cube used to demonstrate OBJ loading.
mtllib cube.mtl
o TexturedCube

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

usemtl RedPanel
f 1/1/1 2/2/1 3/3/1 4/4/1
usemtl BluePanel
f 6/1/2 5/2/2 8/3/2 7/4/2
usemtl GreenPanel
f 5/1/3 1/2/3 4/3/3 8/4/3
usemtl GoldPanel
f 2/1/4 6/2/4 7/3/4 3/4/4
usemtl WhitePanel
f 5/1/5 6/2/5 2/3/5 1/4/5
usemtl PurplePanel
f 4/1/6 3/2/6 7/3/6 8/4/6
